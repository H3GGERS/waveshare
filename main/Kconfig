# Main component configuration
menu "Clock / WiFi Configuration"
    config WIFI_SSID
        string "WiFi SSID"
        default "your_ssid"
        help
            SSID of the WiFi AP to connect to for NTP.

    config WIFI_PASSWORD
        string "WiFi Password"
        default "your_password"
        help
            Password of the WiFi AP.

    config CHESS_USERNAME
        string "Chess.com Username"
        default "H3GGERS"
        help
            Chess.com username used to fetch daily games.

    config CHESS_REFRESH_SECONDS
        int "Chess refresh interval (seconds)"
        range 15 3600
        default 60
        help
            Polling interval for refreshing the selected daily game board.
endmenu
